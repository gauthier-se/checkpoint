# Automatic activation of the devenv shell (https://direnv.net).
# Run `direnv allow` once; afterwards entering the repo loads the toolchain.
if ! has devenv; then
  echo "devenv is not installed: see https://devenv.sh/getting-started/" >&2
  echo "(the manual setup documented in the README stays fully supported)" >&2
  exit 0
fi

eval "$(devenv direnvrc)"

use devenv
